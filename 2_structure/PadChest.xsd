<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="PadChest">
        <xs:complexType>
            <xs:sequence>

                <xs:element name="Rapports">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Rapport"
                                        minOccurs="1"
                                        maxOccurs="unbounded">
                                <xs:complexType>
                                    <xs:simpleContent>
                                        <xs:extension base="xs:string">
                                            <xs:attribute name="id"
                                                          type="xs:ID"
                                                          use="required"/>
                                        </xs:extension>
                                    </xs:simpleContent>
                                </xs:complexType>
                            </xs:element>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>

                <xs:element name="Patient"
                            minOccurs="1"
                            maxOccurs="unbounded">

                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Naissance" type="TypeNaissance" minOccurs="0"/>
                            <xs:element name="Sexe" type="TypeSexe" minOccurs="0"/>
                            <xs:element name="Etude"
                                        minOccurs="1"
                                        maxOccurs="unbounded">

                                <xs:complexType>
                                    <xs:sequence>
                                        <xs:element name="Image"
                                                    minOccurs="1"
                                                    maxOccurs="unbounded">

                                            <xs:complexType>
                                                <xs:sequence>
                                                    <xs:element name="ImageDir" type="TypeImageDir"/>
                                                    <xs:element name="Projection" type="TypeProjection"/>
                                                    <xs:element name="MethodProjection" type="TypeMethodeProjection"/>
                                                    <xs:element name="Pediatric" type="TypePediatric"/>
                                                    <xs:element name="MethodLabel" type="TypeMethodeLabel"/>
                                                    <xs:element name="Labels" type="xs:string"/>
                                                    <xs:element name="Localizations" type="xs:string"/>
                                                    <xs:element name="LabelsLocalizationsBySentence" type="xs:string"/>
                                                    <xs:element name="LabelCUIS" type="xs:string"/>
                                                    <xs:element name="LocalizationsCUIS" type="xs:string"/>
                                                </xs:sequence>

                                                <xs:attribute name="id"
                                                              type="xs:ID"
                                                              use="required"/>
                                                <xs:attribute name="rapportRef"
                                                              type="xs:IDREF"
                                                              use="required"/>
                                            </xs:complexType>

                                        </xs:element>
                                    </xs:sequence>

                                    <xs:attribute name="id"
                                                  type="xs:ID"
                                                  use="required"/>
                                </xs:complexType>

                            </xs:element>
                        </xs:sequence>

                        <xs:attribute name="id"
                                      type="xs:ID"
                                      use="required"/>
                    </xs:complexType>

                </xs:element>
            </xs:sequence>
        </xs:complexType>

        <xs:key name="CleRapport">
            <xs:selector xpath="Rapports/Rapport"/>
            <xs:field xpath="@id"/>
        </xs:key>

        <xs:keyref name="ReferenceRapport" refer="CleRapport">
            <xs:selector xpath="Patient/Etude/Image"/>
            <xs:field xpath="@rapportRef"/>
        </xs:keyref>
    </xs:element>

    <xs:simpleType name="TypeProjection">
        <xs:restriction base="xs:string">
            <xs:enumeration value="PA"/>
            <xs:enumeration value="L"/>
            <xs:enumeration value="AP"/>
            <xs:enumeration value="AP_horizontal"/>
            <xs:enumeration value="COSTAL"/>
            <xs:enumeration value="UNK"/>
            <xs:enumeration value="EXCLUDE"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeNaissance">
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{4}"/>        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeSexe">
        <xs:restriction base="xs:string">
            <xs:enumeration value="M"/>
            <xs:enumeration value="F"/>
            <xs:enumeration value="O"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypePediatric">
        <xs:restriction base="xs:string">
            <xs:enumeration value="No"/>
            <xs:enumeration value="PED"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeMethodeProjection">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Manual review of DICOM fields"/>
            <xs:enumeration value="resnet-50.t7"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeMethodeLabel">
        <xs:restriction base="xs:string">
            <xs:enumeration value="Physician"/>
            <xs:enumeration value="RNN_model"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="TypeImageDir">
        <xs:restriction base="xs:nonNegativeInteger"/>
    </xs:simpleType>
</xs:schema>